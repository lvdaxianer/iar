# IAR 模型接入的环境变量示例。
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不要提交真实密钥。

# ===== 通用大模型（LLM）=====
# 负责开放式语义理解和文本生成的三个角色：
#   semantic.extract  从用户输入抽取主语、意图、槽位、指代
#   context.compact   把历史对话压缩成结构化摘要（保留行为状态）
#   response.generate 生成面向用户的自然语言回复
# 两个用途共用这组变量：
#   1. examples/agent-sandbox（测试 agent）的大脑直接读取它们；
#   2. IAR 运行时 profile 通过 environment.modelId 指向模型变量，避免把真实值写入配置。
IAR_LLM_BASE_URL=CHANGE_ME
IAR_LLM_API_KEY=CHANGE_ME
IAR_LLM_MODEL_ID=CHANGE_ME
# 日志输出格式：json（默认，机器解析）或 pretty（中文+英文可读摘要）。
IAR_LOG_FORMAT=json

# 通用大模型密钥的备选变量名：上面 IAR_LLM_API_KEY 未设置时，
# 沙盒的大脑 provider 会回退读取这个变量（二选一即可）。
IAR_MODEL_API_KEY=CHANGE_ME

# ===== JEV 决策模型 =====
# 负责受限的结构化选择，两个角色使用：
#   function.select  在规则圈定的候选 Function 中选择/拒绝/澄清
#   plugin.select    在当前 Function 已授权的候选 Plugin 中选择
# JEV 只输出 choice/score/noul 等可校验结构，不做文本生成。
# 目前 IAR 核心尚无 JEV 客户端实现，这两个变量为设计预留。
IAR_JEV_ENDPOINT=CHANGE_ME
IAR_JEV_API_KEY=CHANGE_ME
IAR_JEV_MODEL_ID=CHANGE_ME

# ===== Intent Model 决策模型（可选） =====
# 与 JEV 平行，为 function.select/plugin.select 返回同一 iar.decision/v1。
# config/models.yaml 已提供示例 profile；JEV 存在时按固定优先级不会选中 Intent Model。
# 仅移除/停用对应 JEV profile 后，Intent Model profile 才会成为 primary。
IAR_INTENT_MODEL_ENDPOINT=CHANGE_ME
IAR_INTENT_MODEL_API_KEY=CHANGE_ME
IAR_INTENT_MODEL_ID=intent-model-placeholder
IAR_INTENT_MODEL_VERSION=example-1

# 普通模型与 Intent Model 的环境映射优先级：
# profile.environment 中声明的非空变量值 > provider 显式默认值 > provider 默认环境变量 > profile.modelId（仅模型名）。
# endpoint 和 API key 没有有效值时 provider fail-closed，不会把密钥写入 profile、审计或错误消息。
# agent-sandbox 可用 IAR_SANDBOX_DECISION_BACKEND=intent-model 仅启用 Intent Model；未设置时保持 JEV 优先。

# Intent Prompt 版本由 IAR 固定为 iar.intent-decision-prompt/v1，不接受 provider 覆盖。
# 跨 backend fallback 默认关闭；只有调用方显式设置 crossBackendFallback: true 才启用。

# ===== 会话持久化 Provider =====
# 默认加载内置 SQLite Provider；默认文件为仓库运行目录下 data/iar-sandbox.sqlite。
# IAR_SANDBOX_SQLITE_PATH 可以覆盖 SQLite 文件路径，正常关闭会等待已接受的异步写入。
IAR_PERSISTENCE_PROVIDER=sqlite
IAR_SANDBOX_SQLITE_PATH=./data/iar-sandbox.sqlite
# 外部 Provider：填写与模块 Manifest 一致的 providerId 和可动态 import 的模块入口。
# IAR_PERSISTENCE_PROVIDER=your-provider
# IAR_PERSISTENCE_MODULE=your-provider-package
# 可选 JSON 对象传给外部 Provider；SQLite 也可用它覆盖 filename/queueCapacity。
# IAR_PERSISTENCE_OPTIONS_JSON={"queueCapacity":128}
