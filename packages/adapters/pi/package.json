{
  "name": "@iar/pi-bridge",
  "version": "0.1.0",
  "description": "IAR Pi Bridge：把 Pi 输入扩展为可选意图路由层",
  "license": "MIT",
  "author": "lvdaxianer <lvdaxianer@yeah.net>",
  "homepage": "https://github.com/lvdaxianer/iar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvdaxianer/iar.git",
    "directory": "packages/adapters/pi"
  },
  "keywords": [
    "pi-package",
    "iar",
    "intent-routing"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pi-extension": {
      "types": "./dist/pi-extension.d.ts",
      "import": "./dist/pi-extension.js"
    }
  },
  "files": [
    "dist"
  ],
  "pi": {
    "extensions": [
      "./dist/pi-extension.js"
    ]
  }
}
