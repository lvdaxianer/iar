{
  "name": "iar",
  "version": "0.1.0",
  "private": true,
  "description": "Intent Action Runtime",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsc -p tsconfig.tests.build.json",
    "clean": "tsc -b tsconfig.build.json --clean && tsc -b tsconfig.tests.build.json --clean",
    "lint": "tsc -p tsconfig.json --noEmit",
    "verify:packages": "node scripts/verify-package-distribution.mjs",
    "test": "npm run build && node scripts/run-tests.mjs",
    "demo:fake-plugin": "npm run build && node scripts/run-fake-plugin-demo.mjs",
    "demo:sandbox": "npm run build && node scripts/run-agent-sandbox.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pg-mem": "^3.0.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "fastify": "^5.12.7"
  }
}
